"Algorithm":
{
    "Sorting":
    {
        "BubbleSort":
        {
            "meta":
            {
                "cmdtitle": "冒泡排序",
                "title": "Bubble Sort",
                "description": "Bubble Sort is a {yellow}simple{skyblue} sorting algorithm that repeatedly steps through the list, \ncompares adjacent elements and swaps them if they are in the wrong order. \nThe pass through the list is repeated until the list is sorted.",
                "author": "Git-1145",
                "date": "2026-08-13"
            },
            "sort_method":
            {
                "name":"Choose the sorting RULE",
                "options":["Ascending","Descending"]
            },
            "time_complexity":"{skyblue}O(n^2){/}"
        },
        "BucketSort":
        {
            "meta":
            {
                "cmdtitle": "朴素桶排序",
                "title": "Bucket Sort",
                "description": "Bucket Sort is a {yellow}distribution{skyblue} sorting algorithm that works\n by distributing the elements of an array into a number of buckets. \nEach bucket is then sorted individually, either using a different sorting algorithm\n or by recursively applying the bucket sort algorithm. \nThe elements are then collected from the buckets in order to obtain the sorted array.
                                {red}This file is positive-integer-only!{/}",
                "author": "Git-1145",
                "date": "2026-08-14"
            },
            "sort_method":
            {
                "name":"Choose the sorting RULE",
                "options":["Ascending","Descending"]
            },
            "time_complexity":"{skyblue}O(n){/}"
        },
        "BogoSort":
        {
            "meta":
            {
                "cmdtitle": "猴子排序",
                "title": "Bogo Sort",
                "description":"Bogo sort is a humorous, highly‑inefficient sorting algorithm\nIt repeatedly randomly shuffles the array and checks whether it becomes sorted\n It stops only when luck produces an ordered sequence\n{orange}It is for teaching fun concepts and never used in real‑world projects{/}",
                "author":"ByeByeBite",
                "date":"2026-08-24"
            },
            "sort_method":
            {
                "name":"Choose the sorting RULE",
                "options":["Ascending","Descending"]
            },
            "time_complexity":"{skyblue}O(n * n!){green}\nBEST: O(1)\n{red}WORST: O(inf){/}"
        }
    },
    "Searching":
    {
        "DFS":
        {
            "meta":
            {
                "cmdtitle": "深度优先搜索",
                "title": "Depth-First Search",
                "description": "Depth‑First Search explores as far as possible along one path before backtracking\nIt can enumerate all paths
                 but cannot rapidly get the shortest path in unweighted mazes.{red}time_complexity is O(4^n){/}",
                "author": "ByeByeBite",
                "date": "2026-08-20"
            }
        },
        "BFS":
        {
            "meta":
            {
                "cmdtitle": "广度优先搜索",
                "title": "Breadth-First Search",
                "description": "Breadth‑First Search uses a queue to visit nodes layer by layer\nThe first time it reaches the target guarantees\nthe shortest path for unweighted grid‑based mazes.",
                "author": "ByeByeBite",
                "date": "2026-08-21"
            }
        },
        "AStar":
        {
            "meta":
            {
                "cmdtitle": "A* 搜索",
                "title": "A* Search",
                "description": "A* uses a priority queue guided by f = g + h to find the shortest path\nIt combines the advantages of Dijkstra (optimality) and Greedy (efficiency)\nusing Manhattan distance as heuristic.",
                "author": "ByeByeBite",
                "date": "2026-08-22"
            }
        }
    },
